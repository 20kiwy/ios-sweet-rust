+++ b/hw/core/sysbus-fdt.c
@@ -38,6 +38,7 @@
 #include "hw/display/ramfb.h"
 #include "hw/uefi/var-service-api.h"
 #include "hw/arm/fdt.h"
+#include "hw/arm/sweet_devices.h"
 
 /*
  * internal struct that contains the information to create dynamic
@@ -519,6 +520,12 @@ static const BindingEntry bindings[] = {
 #endif
     TYPE_BINDING(TYPE_RAMFB_DEVICE, no_fdt_node),
     TYPE_BINDING(TYPE_UEFI_VARS_SYSBUS, add_uefi_vars_node),
+    /* ios-sweet-rust: the T8015 display-path device models describe
+     * themselves in the payload's Apple DeviceTree (the guest ignores the
+     * QEMU-generated FDT), so they get no FDT node. */
+    TYPE_BINDING(TYPE_SWEET_DART, no_fdt_node),
+    TYPE_BINDING(TYPE_SWEET_MIPI, no_fdt_node),
+    TYPE_BINDING(TYPE_SWEET_DISP0, no_fdt_node),
     TYPE_BINDING("", NULL), /* last element */
 };
 
