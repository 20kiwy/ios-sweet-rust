diff --git a/hmp-commands.hx b/hmp-commands.hx
index 06746f0..8292b96 100644
--- a/hmp-commands.hx
+++ b/hmp-commands.hx
@@ -1859,3 +1859,20 @@ SRST
   List event channels in the guest
 ERST
 #endif
+
+HXCOMM ios-sweet-rust: host-driven framebuffer swap hook (sweet-disp0).
+
+    {
+        .name       = "sweet-disp0-swap",
+        .args_type  = "addr:s",
+        .params     = "addr",
+        .help       = "blit the BGRA surface at guest physical address addr into the sweet-disp0 framebuffer",
+        .cmd        = hmp_sweet_disp0_swap,
+    },
+
+SRST
+``sweet-disp0-swap`` *addr*
+  ios-sweet device hook: read the BGRA surface at guest physical address
+  *addr* through the sweet-disp0 DART address space and write it to the
+  framebuffer (``fb-base``).  See the qemu-sweet README.
+ERST
