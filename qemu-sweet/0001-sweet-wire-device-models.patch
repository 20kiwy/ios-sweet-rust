+    machine_class_allow_dynamic_sysbus_dev(mc, TYPE_SWEET_DISP0);
 #ifdef CONFIG_TPM
     machine_class_allow_dynamic_sysbus_dev(mc, TYPE_TPM_TIS_SYSBUS);
 #endif
