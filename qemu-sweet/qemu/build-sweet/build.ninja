# This is the build file for project "qemu"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER
 command = gcc -m64 $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

# Rules for linking.

rule STATIC_LINKER
 command = rm -f $out && ar $LINK_ARGS $out $in
 description = Linking static target $out

rule STATIC_LINKER_RSP
 command = rm -f $out && ar $LINK_ARGS $out @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $in
 description = Linking static target $out

rule c_LINKER
 command = gcc -m64 $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule c_LINKER_RSP
 command = gcc -m64 @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule SHSYM
 command = /home/z/ios-sweet-rust/qemu-sweet/qemu/build-sweet/pyvenv/bin/meson --internal symbolextractor /home/z/ios-sweet-rust/qemu-sweet/qemu/build-sweet $in $IMPLIB $out $CROSS
 description = Generating symbol file $out
 restat = 1

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /home/z/ios-sweet-rust/qemu-sweet/qemu/build-sweet/pyvenv/bin/meson --internal regenerate /home/z/ios-sweet-rust/qemu-sweet/qemu .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

