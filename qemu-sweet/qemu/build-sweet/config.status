#!/bin/sh
# Generated by configure.
# Run this file to recreate the current configuration.
# Compiler output produced by configure, useful for debugging
# configure, is in config.log if it exists.
unset AR
unset AS
CC='gcc'
export CC
unset CFLAGS
unset CXX
unset CXXFLAGS
unset DLLTOOL
unset LD
unset LDFLAGS
unset LD_LIBRARY_PATH
unset NM
unset OBJCFLAGS
unset OBJCOPY
PATH='/home/z/.venv/bin:/home/z/.venv/bin:/home/z/.venv/bin:/home/z/.npm-global/bin:/home/z/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bun-node-fallback-bin'
export PATH
unset PKG_CONFIG
unset PKG_CONFIG_LIBDIR
unset PKG_CONFIG_PATH
unset PYTHON
unset QEMU_GA_MANUFACTURER
unset QEMU_GA_DISTRO
unset QEMU_GA_VERSION
unset SDL2_CONFIG
unset SMBD
unset STRIP
unset WIDL
unset WINDRES
unset WINDMC
exec '/home/z/ios-sweet-rust/qemu-sweet/qemu/configure' '--target-list=aarch64-softmmu' '--cc=gcc' '--disable-docs' '--disable-tools' '--disable-guest-agent' '--disable-strip' '--disable-debug-info' '--disable-slirp' '--disable-seccomp' '--disable-libnfs' '--disable-usb-redir' '--disable-spice' '--disable-opengl' '--disable-gtk' '--disable-sdl' '--disable-vnc' '--disable-xkbcommon' '--disable-auth-pam' '--disable-glusterfs' '--disable-libssh' '--disable-lzo' '--disable-snappy' '--disable-curl' '--disable-gnutls' '--disable-nettle' '--disable-gcrypt' '--disable-brlapi' '--disable-rbd' '--disable-libiscsi' "$@"
